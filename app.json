{
  "configVersion": "v3",
  "app": {
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "appId": 1000011,
    "appName": "WristTrack",
    "_pikeCompatibled": 1,
    "icon": "icon.png",
    "vender": "Community",
    "description": "A serverless wrist timer for Toggl Track"
  },
  "runtime": {
    "apiVersion": {
      "compatible": "3.0",
      "target": "4.0",
      "minVersion": "3.0"
    }
  },
  "targets": {
    "bip-max": {
      "module": {
        "page": {
          "pages": [
            "page/home/index.page"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "s",
          "sr": "w432",
          "dw": 432
        }
      ],
      "designWidth": 432
    }
  },
  "permissions": [
    "data:os.device.info"
  ],
  "i18n": {
    "en-US": {
      "name": "WristTrack"
    }
  },
  "defaultLanguage": "en-US",
  "debug": false
}
